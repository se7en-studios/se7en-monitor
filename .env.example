# ==========================================
# SE7EN MONITOR — CONFIGURACIÓN DE ENTORNO
# Backend: Google Firebase (Firestore + Auth + WebRTC Signaling)
# ==========================================

# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Dirección https pública. Si empieza con https://, los QR de vinculación de celulares apuntan ahí
# (el navegador del celular solo permite la cámara en https). En local dejar http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# TURN (opcional, recomendado en producción). Sin TURN, celulares detrás de CGNAT o redes
# móviles estrictas pueden no conectar. Los STUN públicos de Google ya vienen incluidos.
# Estas variables viajan al navegador: usar credenciales temporales del servicio TURN,
# nunca una clave maestra. Si NEXT_PUBLIC_TURN_URLS está vacío, no se usa TURN.
# NEXT_PUBLIC_TURN_URLS=turn:turn.ejemplo.com:3478,turns:turn.ejemplo.com:5349
# NEXT_PUBLIC_TURN_USERNAME=
# NEXT_PUBLIC_TURN_CREDENTIAL=

# Muestra en Configuración la tarjeta "Cargar datos demo" (solo Super Admin).
# Dejar vacío o en 0 en producción: con "1" se pueden cargar escuelas e incidentes ficticios.
NEXT_PUBLIC_DEMO=0

# Environment Mode
NODE_ENV=development
